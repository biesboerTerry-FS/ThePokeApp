{
  "expo": {
    "name": "thePokeApp",
    "slug": "thepokeapp",
    "scheme": "thepokeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/banner.png",
      "resizeMode": "contain",
      "backgroundColor": "#ef5350",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.thepokeapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ef5350"
      },
      "package": "com.anonymous.thepokeapp"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      "@clerk/expo",
      "expo-font"
    ]
  }
}
