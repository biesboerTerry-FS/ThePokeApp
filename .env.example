# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app.

# Point the app at the running backend during local development.
# The backend mounts its routes under /api/v1 — include that path in the base URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Cloudinary (optional). Both values are required to enable cloud image storage:
# avatar uploads and "Add my photo" sprites. The upload preset MUST be UNSIGNED.
# See CLOUD_STORAGE_SETUP.md for step-by-step setup.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# If either Cloudinary value is missing, images are saved as data URLs in the
# app's local AsyncStorage state instead, so the demo keeps working offline.
