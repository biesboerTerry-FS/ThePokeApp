# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app.

# Clerk publishable key (enables multi-provider sign-in via Clerk).
# Create an app at https://dashboard.clerk.com, enable OAuth providers, and
# add the redirect URL thepokeapp://sso-callback (and the Expo web URL if used).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: point the app at a running backend (default: http://<dev-host>:8000/api/v1)
EXPO_PUBLIC_API_BASE_URL=

# Legacy: direct Google OAuth client ID (replaced by Clerk sign-in).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
