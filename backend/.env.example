# Copy to backend/.env and fill in.

# MongoDB connection string. Local default shown; replace with your hosted URI.
MONGODB_URI=mongodb://127.0.0.1:27017/pokedex

# Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=change-me-in-production

# Google OAuth client credentials (optional; used for real Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=8000
NODE_ENV=development

# Allow the one-click demo login in development.
DEMO_LOGIN=true
